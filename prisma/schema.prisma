// Vowly Invites — Prisma 7
// URL lives in prisma.config.ts

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  COUPLE
}

enum Package {
  BASIC
  CLASSIC
  PREMIUM
}

enum WeddingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InviteType {
  MR
  MS
  MRS
  MR_AND_MRS
  FAMILY
}

enum GuestSide {
  BRIDE
  GROOM
  BOTH
}

enum ShareStatus {
  NOT_SHARED
  COPIED
  WA_OPENED
}

enum LeadStatus {
  NEW
  CONTACTED
  PAID
  CONVERTED
  LOST
}

enum AssetSlot {
  CORNER_TOP_RIGHT
  CORNER_BOTTOM_LEFT
  BG_WASH
  CORNER_TOP_LEFT
  CORNER_BOTTOM_RIGHT
  MONOGRAM
  DIVIDER_FLOURISH
}

enum FileType {
  PNG
  SVG
}

enum SenderRole {
  ADMIN
  COUPLE
  SYSTEM
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?
  name         String
  passwordHash String
  avatarUrl    String?
  role         UserRole  @default(COUPLE)
  createdAt    DateTime  @default(now())
  wedding      Wedding?
}

model Wedding {
  id                String        @id @default(uuid())
  slug              String        @unique
  coupleId          String        @unique
  couple            User          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  package           Package       @default(BASIC)
  status            WeddingStatus @default(DRAFT)
  sectionOrder      Json          @default("[\"hero\",\"love_story\",\"events\",\"gallery\",\"rsvp\",\"wishes\"]")
  rsvpDeadline      DateTime?
  momentsUnlockTime DateTime?
  createdAt         DateTime      @default(now())
  content           WeddingContent?
  theme             WeddingTheme?
  assets            WeddingAsset[]
  events            WeddingEvent[]
  guests            Guest[]
  rsvps             RSVP[]
  galleryPhotos     GalleryPhoto[]
  guestMoments      GuestMoment[]
  wishes            GuestWish[]
  chatMessages      ChatMessage[]
}

model WeddingContent {
  id                      String    @id @default(uuid())
  weddingId               String    @unique
  wedding                 Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  brideName               String    @default("")
  groomName               String    @default("")
  brideParents            String    @default("")
  groomParents            String    @default("")
  bridePhone              String    @default("")
  groomPhone              String    @default("")
  weddingDate             DateTime?
  venue                   String    @default("")
  subVenue                String    @default("")
  venueAddress            String    @default("")
  googleMapsUrl           String    @default("")
  preInvitationText       String    @default("")
  invitationLine          String    @default("")
  loveStory               String    @default("")
  heroImageUrl            String    @default("")
  dressCode               String    @default("")
  religiousCeremony       String    @default("")
  postCeremonyNote        String    @default("")
  specialNote             String    @default("")
  whatsappMessageTemplate String    @default("")
  updatedAt               DateTime  @updatedAt
}

model WeddingTheme {
  id           String  @id @default(uuid())
  weddingId    String  @unique
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  primaryColor String  @default("#C9606A")
  accentColor  String  @default("#C9A84C")
  bgTint       String  @default("#FDF9F5")
  scriptFont   String  @default("Cormorant Garamond")
  capsFont     String  @default("Cinzel")
  bodyFont     String  @default("Jost")
  isCustom     Boolean @default(false)
}

model WeddingAsset {
  id                 String    @id @default(uuid())
  weddingId          String
  wedding            Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  slot               AssetSlot
  cloudinaryUrl      String
  cloudinaryPublicId String
  opacity            Float     @default(0.85)
  sizePercent        Int       @default(52)
  fileType           FileType  @default(PNG)
  uploadedAt         DateTime  @default(now())

  @@unique([weddingId, slot])
}

model WeddingEvent {
  id         String   @id @default(uuid())
  weddingId  String
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title      String
  time       DateTime
  location   String
  nekathTime String?
  notes      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Guest {
  id           String      @id @default(uuid())
  weddingId    String
  wedding      Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name         String
  inviteType   InviteType  @default(MR)
  email        String?
  phone        String?
  token        String      @unique
  maxAttendees Int         @default(1)
  group        String?
  side         GuestSide?
  shareStatus  ShareStatus @default(NOT_SHARED)
  lastSharedAt DateTime?
  createdAt    DateTime    @default(now())
  rsvp         RSVP?
  moments      GuestMoment[]
  wishes       GuestWish[]
}

model RSVP {
  id             String   @id @default(uuid())
  guestId        String   @unique
  guest          Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  weddingId      String
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  attending      Boolean
  attendeeCount  Int      @default(1)
  mealPreference String?
  dietaryNotes   String?
  message        String?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GalleryPhoto {
  id         String   @id @default(uuid())
  weddingId  String
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  url        String
  publicId   String
  caption    String?
  order      Int      @default(0)
  uploadedAt DateTime @default(now())
}

model GuestMoment {
  id         String   @id @default(uuid())
  weddingId  String
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  url        String
  publicId   String
  approved   Boolean  @default(false)
  uploadedAt DateTime @default(now())
}

model GuestWish {
  id        String   @id @default(uuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestId   String?
  guest     Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestName String
  message   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatMessage {
  id             String     @id @default(uuid())
  weddingId      String
  wedding        Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  senderRole     SenderRole
  senderName     String
  content        String
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  isRead         Boolean    @default(false)
  readAt         DateTime?
  createdAt      DateTime   @default(now())
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  email           String
  whatsapp        String
  package         Package    @default(CLASSIC)
  hasDesignerCard Boolean    @default(false)
  status          LeadStatus @default(NEW)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}
